diff --git a/vendor-portal/app/(vendor)/layout.tsx b/vendor-portal/app/(vendor)/layout.tsx
new file mode 100644
index 0000000..17f7dfe
--- /dev/null
+++ b/vendor-portal/app/(vendor)/layout.tsx
@@ -0,0 +1,23 @@
+"use client"
+
+import { SWRConfig } from "swr"
+import VendorShell from "@/components/VendorShell"
+
+// Shared cache config for every vendor page: serve cached data instantly
+// (no blank skeleton on tab switch) while revalidating in the background
+// so data stays live.
+const swrConfig = {
+  revalidateOnFocus: true,
+  revalidateOnReconnect: true,
+  refreshInterval: 30_000, // background poll every 30s for live updates
+  dedupingInterval: 5_000,
+  keepPreviousData: true,
+}
+
+export default function VendorLayout({ children }: { children: React.ReactNode }) {
+  return (
+    <SWRConfig value={swrConfig}>
+      <VendorShell>{children}</VendorShell>
+    </SWRConfig>
+  )
+}
