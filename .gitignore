# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.local-push/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep examples, ignore real secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env
!.env.example
!.env.local.example
!*example*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling caches
.eslintcache
.stylelintcache
.turbo
.swc/
.cache/
.parcel-cache/

# editors/OS
.vscode/
.idea/
Thumbs.db
CON

# Local scripts and sensitive folders (do not commit)
oc-api/
oc-api/**

# Ensure nested node_modules are ignored
node_modules/
**/node_modules/

# my-medusa-store local secrets and deps
my-medusa-store/.env
my-medusa-store/node_modules/
my-medusa-store/yarn.lock
opencart-etl.log
opencart-etl-previous.log
# Medusa build artifacts
my-medusa-store/.medusa/
.medusa/

# Debug and test JSON files  
*_dump*.json
*_test*.json
*_result*.json
*_fix*.json
order_*.json
recent_*.json
deep_*.json
fulfillment_*.json
allocate_*.json
current_*.json
force_*.json

# Temporary debug files
URGENT_FIX.md

# Auto-generated Medusa types - regenerated on every build
my-medusa-store/.medusa/types/

# Local-only S3 upload tester (contains AWS credentials, never commit)
test-s3-upload.html

# Serwist (generated at build time)
public/sw.js
public/sw.js.map
public/swe-worker*

# Local venv for PWA asset generation script
.venv-pwa/
.env.meilisearch
.env.web-push
**/.env.web-push
.env.meilisearch.*
!.env.meilisearch.example
