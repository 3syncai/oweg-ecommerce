{
    "buildCommand": "npm run build:admin",
    "outputDirectory": ".medusa/admin",
    "headers": [
        { "source": "/app/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ],
    "rewrites": [
        {
            "source": "/admin/:path*",
            "destination": "https://api.oweg.itshover.com/admin/:path*"
        },
        {
            "source": "/store/:path*",
            "destination": "https://api.oweg.itshover.com/store/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "https://api.oweg.itshover.com/auth/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "https://api.oweg.itshover.com/:path*"
        },
        {
            "source": "/app/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/app",
            "destination": "/index.html"
        },
        {
            "source": "/app/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/",
            "destination": "/index.html"
        }
    ]
}
